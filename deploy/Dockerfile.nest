# One image for all NestJS services: builds every app once, each container runs one of them.
#   docker compose: command: node dist/apps/<app>/main.js
FROM node:22.14.0-bookworm-slim AS build
WORKDIR /app
ENV NX_DAEMON=false NX_NO_CLOUD=true NX_SKIP_NX_CACHE=true CI=true
RUN corepack enable && corepack prepare pnpm@10.22.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN npx nx run-many -t build \
      -p authorizer,bff,booking,chat,mail,media,slot,user-access \
      --parallel=2 --skip-nx-cache

FROM node:22.14.0-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/dist ./dist
